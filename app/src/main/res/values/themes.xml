<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AppLock" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/primary_dark</item>
    </style>

    <style name="Theme.AppLock.Lock">
        <item name="android:windowBackground">@color/lock_background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/lock_background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

</resources>
