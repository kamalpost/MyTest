<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusPhone" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/setup_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/setup_bg</item>
        <item name="android:colorAccent">@color/setup_accent</item>
    </style>

    <style name="Theme.FocusPhone.Kiosk" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bezel</item>
        <item name="android:statusBarColor">@color/bezel</item>
        <item name="android:navigationBarColor">@color/bezel</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
